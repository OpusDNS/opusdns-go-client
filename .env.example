# OpusDNS API Configuration
# Copy this file to .env and fill in your values.
#
# These are the only environment variables the library reads (see
# opusdns/config.go). Timeouts, retries and the default record TTL are set in
# code with the opusdns.With... options.

# Required: Your OpusDNS API key
# Get this from https://dashboard.opusdns.com
OPUSDNS_API_KEY=opk_your_api_key_here

# Optional: API endpoint (defaults to production)
# Production: https://api.opusdns.com
# Sandbox: https://sandbox.opusdns.com
OPUSDNS_API_ENDPOINT=https://api.opusdns.com

# Optional: API version path prefix (default: v1)
# OPUSDNS_API_VERSION=v1

# Optional: log HTTP requests and responses ("true" or "1")
# OPUSDNS_DEBUG=true
